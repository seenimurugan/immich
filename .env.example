# ---------------------------------------------------------------------------
# immich — environment variables
# Copy this file to .env, fill in real values, then run ./deploy.sh
# ---------------------------------------------------------------------------

# ── Kubernetes ──────────────────────────────────────────────────────────────
# Namespace to deploy into (must exist or deploy.sh will create it)
HOMELAB_NAMESPACE=homelab

# ── HDD paths (macOS host) ──────────────────────────────────────────────────
# Primary HDD — where the Immich photo library lives (photos-readonly-pv.yaml)
HOMELAB_HDD_PATH=/Volumes/Seeni's HDD

# Tier HDD — where tiered files and backups land (immich-values.yaml + backup-cronjob.yaml)
# This is the /data-hdd mount inside the server pod AND the backup target.
HOMELAB_TIER_HDD_PATH=/Volumes/homelab-hdd

# ── Database ────────────────────────────────────────────────────────────────
# Postgres password for immich-postgres-secret.
# Generate a strong one:  openssl rand -hex 32
IMMICH_DB_PASSWORD=change-me

# ── Upload PVC (MACHINE-SPECIFIC — must be re-discovered on a new cluster) ──
# After first deploy on a new cluster, run:
#   kubectl get pv | grep immich-upload
# Find the local-path PV backing the immich library PVC and note the path
# (e.g. /var/lib/rancher/k3s/storage/pvc-<uuid>).
# Set IMMICH_UPLOAD_PV_PATH to that path if you need to reference it directly.
# The PVC name in immich-values.yaml (immich-upload-localpath-pvc) will need
# to be updated to match the new cluster's PVC name.
# See README.md "Non-portable bits" for the full procedure.
IMMICH_UPLOAD_PV_PATH=
